rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(key) {
      return key is string && key.size() == 10 && key.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthKey(key) {
      return key is string && key.size() == 7 && key.matches('^20[0-9]{2}-[0-9]{2}$');
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidStudentProfile(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
             data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120 &&
             data.studentIdNumber is string && data.studentIdNumber.size() >= 2 && data.studentIdNumber.size() <= 60 &&
             data.studentIdHash is string && data.studentIdHash.size() >= 16 && data.studentIdHash.size() <= 128 &&
             data.gradeLevel is string && data.gradeLevel.size() >= 2 && data.gradeLevel.size() <= 40 &&
             data.verificationStatus in ['verified', 'pending'] &&
             data.rewardPoints is int && data.rewardPoints >= 0 && data.rewardPoints <= 1000000 &&
             data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 1000000 &&
             data.tournamentsCompleted is int && data.tournamentsCompleted >= 0 && data.tournamentsCompleted <= 10000 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 3650 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 3650 &&
             data.adRewardCountToday is int && data.adRewardCountToday >= 0 && data.adRewardCountToday <= 3 &&
             data.categoryStats is map && data.categoryStats.size() <= 12 &&
             (!('lastPlayedDate' in data) || data.lastPlayedDate == null || isValidDateKey(data.lastPlayedDate)) &&
             (!('adRewardDate' in data) || data.adRewardDate == null || isValidDateKey(data.adRewardDate)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyTournament(data) {
      return isValidDateKey(data.dateKey) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
             data.theme is string && data.theme.size() >= 2 && data.theme.size() <= 120 &&
             data.questions is list && data.questions.size() >= 5 && data.questions.size() <= 50 &&
             data.questions[0] is map &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRankRewardPoints(passed, points) {
      return points is int &&
             (passed ? (points in [5, 10, 20, 50]) : (points == 0));
    }

    function isValidSubmission(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             isValidDateKey(data.dateKey) &&
             isValidMonthKey(data.monthKey) &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 80 &&
             data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120 &&
             data.gradeLevel is string && data.gradeLevel.size() >= 2 && data.gradeLevel.size() <= 40 &&
             data.score is number && data.score >= -50 && data.score <= 50 &&
             data.totalQuestions is int && data.totalQuestions >= 5 && data.totalQuestions <= 50 &&
             data.score <= data.totalQuestions &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= data.totalQuestions &&
             data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= data.totalQuestions &&
             (data.correctCount + data.wrongCount + data.unansweredCount == data.totalQuestions) &&
             data.passed is bool &&
             data.rank is int && data.rank >= 1 && data.rank <= 1000000 &&
             data.durationMillis is int && data.durationMillis >= 1000 && data.durationMillis <= 1500000 &&
             isValidRankRewardPoints(data.passed, data.pointsEarned) &&
             data.visibility == 'public_leaderboard' &&
             data.submittedAt is timestamp && data.submittedAt <= request.time;
    }

    function isValidMonthlyRanking(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             isValidMonthKey(data.monthKey) &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 80 &&
             data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120 &&
             data.gradeLevel is string && data.gradeLevel.size() >= 2 && data.gradeLevel.size() <= 40 &&
             data.monthlyScore is int && data.monthlyScore >= 0 && data.monthlyScore <= 50000 &&
             data.tournamentsPlayed is int && data.tournamentsPlayed >= 1 && data.tournamentsPlayed <= 31 &&
             data.totalDurationMillis is int && data.totalDurationMillis >= 1000 && data.totalDurationMillis <= 2678400000 &&
             data.visibility == 'public_leaderboard' &&
             data.lastSubmittedAt is timestamp && data.lastSubmittedAt <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuizAttempt(data) {
      return isValidDateKey(data.dateKey) &&
             data.score is number && data.score >= -50 && data.score <= 50 &&
             data.totalQuestions is int && data.totalQuestions >= 5 && data.totalQuestions <= 50 &&
             data.score <= data.totalQuestions &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= data.totalQuestions &&
             data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= data.totalQuestions &&
             (data.correctCount + data.wrongCount + data.unansweredCount == data.totalQuestions) &&
             data.passed is bool &&
             data.rank is int && data.rank >= 1 && data.rank <= 1000000 &&
             data.durationMillis is int && data.durationMillis >= 1000 && data.durationMillis <= 1500000 &&
             isValidRankRewardPoints(data.passed, data.pointsEarned) &&
             data.selectedAnswers is list && data.selectedAnswers.size() >= 5 && data.selectedAnswers.size() <= 50 &&
             data.selectedAnswers[0] is int &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRewardClaim(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.rewardId is string && data.rewardId.size() >= 2 && data.rewardId.size() <= 64 &&
             data.rewardTitle is string && data.rewardTitle.size() >= 2 && data.rewardTitle.size() <= 100 &&
             data.rewardCategory in ['gift_card', 'tech_accessory', 'winner_certificate'] &&
             data.pointsCost is int && data.pointsCost >= 0 && data.pointsCost <= 100000 &&
             data.claimCode is string && data.claimCode.size() >= 6 && data.claimCode.size() <= 40 &&
             data.status in ['confirmed', 'issued'] &&
             isValidMonthKey(data.monthKey) &&
             data.claimedAt is timestamp && data.claimedAt <= request.time;
    }

    // --- COLLECTION RULES ---

    // 1. Private Student Profile (PII & ID metadata strictly isolated to owner)
    match /students/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       isValidStudentProfile(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       incoming().rewardPoints == 50 &&
                       incoming().totalScore == 0 &&
                       incoming().tournamentsCompleted == 0 &&
                       incoming().currentStreak == 0 &&
                       incoming().bestStreak == 0 &&
                       incoming().adRewardCountToday == 0 &&
                       incoming().keys().hasAll([
                         'uid', 'displayName', 'schoolName', 'studentIdNumber',
                         'studentIdHash', 'gradeLevel', 'verificationStatus',
                         'rewardPoints', 'totalScore', 'tournamentsCompleted',
                         'currentStreak', 'bestStreak', 'adRewardCountToday',
                         'categoryStats', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid', 'displayName', 'schoolName', 'studentIdNumber',
                         'studentIdHash', 'gradeLevel', 'verificationStatus',
                         'rewardPoints', 'totalScore', 'tournamentsCompleted',
                         'currentStreak', 'bestStreak', 'lastPlayedDate',
                         'adRewardCountToday', 'adRewardDate', 'categoryStats',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       isValidStudentProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action A: Official tournament finish stats & rank-tier points credit (0..50 pts, 0..50 correct)
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                           'rewardPoints', 'totalScore', 'tournamentsCompleted',
                           'currentStreak', 'bestStreak', 'lastPlayedDate',
                           'categoryStats', 'updatedAt'
                         ]) &&
                          incoming().tournamentsCompleted == existing().tournamentsCompleted + 1 &&
                          incoming().rewardPoints >= existing().rewardPoints &&
                          incoming().rewardPoints <= existing().rewardPoints + 50 &&
                          incoming().totalScore >= existing().totalScore &&
                          incoming().totalScore <= existing().totalScore + 50) ||

                         // Action B: Opt-in rewarded ad bonus points (+25 max, 3/day cap)
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                           'rewardPoints', 'adRewardCountToday', 'adRewardDate', 'updatedAt'
                         ]) &&
                          incoming().rewardPoints <= existing().rewardPoints + 25 &&
                          incoming().rewardPoints >= existing().rewardPoints &&
                          incoming().adRewardCountToday <= 3) ||

                         // Action C: Atomic reward store redemption (points deduction only)
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                           'rewardPoints', 'updatedAt'
                         ]) &&
                          incoming().rewardPoints < existing().rewardPoints &&
                          incoming().rewardPoints >= 0) ||

                         // Action D: Re-verify / update Student ID card metadata
                         (incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'schoolName', 'studentIdNumber',
                           'studentIdHash', 'gradeLevel', 'verificationStatus', 'updatedAt'
                         ]))
                       );

      allow delete: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;

      // 1a. Private quiz attempt history for post-quiz review
      match /attempts/{dateKey} {
        allow get: if isSignedIn() && isValidId(uid) && isValidDateKey(dateKey) && request.auth.uid == uid;
        allow list: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;

        allow create: if isSignedIn() &&
                         isValidId(uid) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == uid &&
                         isValidQuizAttempt(incoming()) &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll([
                           'dateKey', 'score', 'correctCount', 'wrongCount', 'unansweredCount',
                           'totalQuestions', 'passed', 'rank', 'durationMillis',
                           'pointsEarned', 'selectedAnswers', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'dateKey', 'score', 'correctCount', 'wrongCount', 'unansweredCount',
                           'totalQuestions', 'passed', 'rank', 'durationMillis',
                           'pointsEarned', 'selectedAnswers', 'createdAt'
                         ]);

        allow update, delete: if false;
      }

      // 1b. Private reward redemption receipts & monthly winner certificates
      match /reward_claims/{claimId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidId(claimId) && request.auth.uid == uid;
        allow list: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;

        allow create: if isSignedIn() &&
                         isValidId(uid) &&
                         isValidId(claimId) &&
                         request.auth.uid == uid &&
                         isValidRewardClaim(incoming()) &&
                         incoming().uid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'uid', 'rewardId', 'rewardTitle', 'rewardCategory',
                           'pointsCost', 'claimCode', 'status', 'monthKey', 'claimedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'uid', 'rewardId', 'rewardTitle', 'rewardCategory',
                           'pointsCost', 'claimCode', 'status', 'monthKey', 'claimedAt'
                         ]) &&
                         exists(/databases/$(database)/documents/students/$(uid));

        allow update, delete: if false;
      }
    }

    // 2. Shared Daily AI GK Tournament (Immutable once 50-question paper is published; allows one-time upgrade from legacy <40 question doc)
    match /daily_tournaments/{dateKey} {
      allow get: if isSignedIn() && isValidDateKey(dateKey);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidDateKey(dateKey) &&
                       isValidDailyTournament(incoming()) &&
                       incoming().dateKey == dateKey &&
                       incoming().createdByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'dateKey', 'title', 'theme', 'questions', 'createdByUid', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'dateKey', 'title', 'theme', 'questions', 'createdByUid', 'createdAt'
                       ]) &&
                       exists(/databases/$(database)/documents/students/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidDateKey(dateKey) &&
                       existing().questions.size() < 40 &&
                       isValidDailyTournament(incoming()) &&
                       incoming().questions.size() >= 40 &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().createdByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'dateKey', 'title', 'theme', 'questions', 'createdByUid', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'dateKey', 'title', 'theme', 'questions', 'createdByUid', 'createdAt'
                       ]) &&
                       exists(/databases/$(database)/documents/students/$(request.auth.uid));

      allow delete: if false;
    }

    // 3. Daily Speed Leaderboard Submissions (Public non-PII scoreboard; immutable once submitted)
    match /tournament_submissions/{submissionId} {
      allow get: if isSignedIn() &&
                    isValidId(submissionId) &&
                    (resource == null || existing().uid == request.auth.uid || existing().visibility == 'public_leaderboard');

      allow list: if isSignedIn() && existing().visibility == 'public_leaderboard';

      allow create: if isSignedIn() &&
                       isValidId(submissionId) &&
                       isValidSubmission(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       submissionId == (incoming().dateKey + '_' + request.auth.uid) &&
                       incoming().keys().hasAll([
                         'uid', 'dateKey', 'monthKey', 'studentName', 'schoolName',
                         'gradeLevel', 'score', 'correctCount', 'wrongCount', 'unansweredCount',
                         'totalQuestions', 'passed', 'rank', 'durationMillis',
                         'pointsEarned', 'visibility', 'submittedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid', 'dateKey', 'monthKey', 'studentName', 'schoolName',
                         'gradeLevel', 'score', 'correctCount', 'wrongCount', 'unansweredCount',
                         'totalQuestions', 'passed', 'rank', 'durationMillis',
                         'pointsEarned', 'visibility', 'submittedAt'
                       ]) &&
                       exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
                       exists(/databases/$(database)/documents/daily_tournaments/$(incoming().dateKey));

      allow update, delete: if false;
    }

    // 4. Monthly Top-Rankers Leaderboard (Public non-PII scoreboard)
    match /monthly_rankings/{rankingId} {
      allow get: if isSignedIn() &&
                    isValidId(rankingId) &&
                    (resource == null || existing().uid == request.auth.uid || existing().visibility == 'public_leaderboard');

      allow list: if isSignedIn() && existing().visibility == 'public_leaderboard';

      allow create: if isSignedIn() &&
                       isValidId(rankingId) &&
                       isValidMonthlyRanking(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       rankingId == (incoming().monthKey + '_' + request.auth.uid) &&
                       incoming().tournamentsPlayed == 1 &&
                       incoming().monthlyScore <= 50 &&
                       incoming().keys().hasAll([
                         'uid', 'monthKey', 'studentName', 'schoolName', 'gradeLevel',
                         'monthlyScore', 'tournamentsPlayed', 'totalDurationMillis',
                         'visibility', 'lastSubmittedAt', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid', 'monthKey', 'studentName', 'schoolName', 'gradeLevel',
                         'monthlyScore', 'tournamentsPlayed', 'totalDurationMillis',
                         'visibility', 'lastSubmittedAt', 'createdAt', 'updatedAt'
                       ]) &&
                       exists(/databases/$(database)/documents/students/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(rankingId) &&
                       isValidMonthlyRanking(incoming()) &&
                       existing().uid == request.auth.uid &&
                       incoming().uid == existing().uid &&
                       incoming().monthKey == existing().monthKey &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().tournamentsPlayed == existing().tournamentsPlayed + 1 &&
                       incoming().monthlyScore >= existing().monthlyScore &&
                       incoming().monthlyScore <= existing().monthlyScore + 50 &&
                       incoming().totalDurationMillis >= existing().totalDurationMillis &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'studentName', 'schoolName', 'gradeLevel', 'monthlyScore',
                         'tournamentsPlayed', 'totalDurationMillis', 'lastSubmittedAt', 'updatedAt'
                       ]);

      allow delete: if false;
    }
  }
}
